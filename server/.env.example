MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/oor_suthalam?retryWrites=true&w=majority
PORT=5000
CLIENT_URL=http://localhost:5173
# Generate a random secret of at least 32 characters for persistent sessions.
JWT_SECRET=
# Optional app-only override if your DNS resolver rejects Atlas SRV queries.
MONGO_DNS_SERVERS=
NODE_ENV=development

# Gmail email replies. Enter an App Password locally; never use a browser VITE_ variable.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Travel assistant: keep the key on the server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
